{
  "name": "@fmweb/designer-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --platform=browser --format=iife --outfile=dist/index.js --sourcemap",
    "dev": "esbuild src/main.tsx --bundle --platform=browser --format=iife --outfile=dist/index.js --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fmweb/shared": "file:../shared",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2"
  }
}
