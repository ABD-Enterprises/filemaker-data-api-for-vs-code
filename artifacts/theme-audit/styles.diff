+
+/* Paper belongs to the page being designed; only the surrounding chrome is themed.
+   Keep its grid above the authored page, whose surface otherwise covers it. */
+.design-surface { background-color: #ffffff; }
+.interaction-layer { background-image: inherit; background-size: inherit; }
+:root { --border: var(--line); }
+.inspector-field input, .action-row select {
+  color: var(--vscode-input-foreground, #333333);
+}
+
+/* Theme colors are paired; HC outlines do not change control geometry. */
+input, select, textarea {
+  background: var(--vscode-input-background, #ffffff);
+  color: var(--vscode-input-foreground, #333333);
+  border-color: var(--vscode-contrastBorder, var(--vscode-input-border, var(--border)));
+  accent-color: var(--vscode-focusBorder, #007acc);
+}
+button, summary {
+  outline: 1px solid var(--vscode-contrastBorder, transparent);
+}
+button:hover, summary:hover {
+  outline-color: var(--vscode-contrastActiveBorder, var(--vscode-contrastBorder, transparent));
+}
+input:focus-visible, select:focus-visible, textarea:focus-visible,
+button:focus-visible, summary:focus-visible, a:focus-visible {
+  outline: 2px solid var(--vscode-contrastActiveBorder, var(--vscode-focusBorder, #007acc));
+  outline-offset: 1px;
+}
+a:any-link { color: var(--vscode-textLink-foreground, #005fb8); }
+
+/* Native placeholder defaults are OS-dependent; keep hints readable. */
+input::placeholder, textarea::placeholder {
+  color: var(--vscode-input-foreground, #333333);
+  opacity: 1;
+}
