{
  "info": {
    "name": "Run script \"Send Welcome\" (layout \"Contacts\")",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Run script \"Send Welcome\" (layout \"Contacts\")",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer <REDACTED>",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/filemaker",
        "description": "Proxy profile: one POST to the proxy, which adds the FileMaker credentials itself.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"runScript\",\n  \"profile\": {\n    \"id\": \"profile-proxy\",\n    \"database\": \"Sales DB\",\n    \"serverUrl\": \"https://fm.example.com\"\n  },\n  \"payload\": {\n    \"layout\": \"Contacts\",\n    \"scriptName\": \"Send Welcome\",\n    \"scriptParam\": \"{\\\"id\\\": 42, \\\"note\\\": \\\"a b&c\\\"}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://proxy.example.com",
      "description": "The server address of the connection profile."
    }
  ]
}
