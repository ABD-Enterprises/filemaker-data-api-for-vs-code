# Proxy profile: one POST to the proxy, which adds the FileMaker credentials itself.
@host = https://proxy.example.com

### Find records in layout "Contacts"
POST {{host}}/filemaker
Content-Type: application/json
Authorization: Bearer <REDACTED>

{
  "action": "findRecords",
  "profile": {
    "id": "profile-proxy",
    "database": "Sales DB",
    "serverUrl": "https://fm.example.com"
  },
  "payload": {
    "layout": "Contacts",
    "body": {
      "query": [
        {
          "City": "Portland",
          "Status": "==Active"
        },
        {
          "City": "Seattle",
          "omit": "true"
        }
      ],
      "sort": [
        {
          "fieldName": "Name",
          "sortOrder": "ascend"
        }
      ],
      "limit": 25,
      "offset": 26
    }
  }
}
