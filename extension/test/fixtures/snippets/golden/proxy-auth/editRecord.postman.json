{
  "info": {
    "name": "Edit record 42 in layout \"Contacts\"",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Edit record 42 in layout \"Contacts\"",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{proxyApiKey}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/filemaker",
        "description": "Proxy profile: one POST to the proxy, which adds the FileMaker credentials itself.\nReplace the modId with the one from the record you read.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"editRecord\",\n  \"profile\": {\n    \"id\": \"profile-proxy\",\n    \"database\": \"Sales DB\",\n    \"serverUrl\": \"https://fm.example.com\"\n  },\n  \"payload\": {\n    \"layout\": \"Contacts\",\n    \"recordId\": \"42\",\n    \"fieldData\": {\n      \"Status\": \"Inactive\"\n    },\n    \"modId\": \"{{modId}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://proxy.example.com",
      "description": "The server address of the connection profile."
    },
    {
      "key": "proxyApiKey",
      "value": "",
      "description": "Proxy API key (fill in; never copied)."
    },
    {
      "key": "modId",
      "value": "",
      "description": "The modId of the record you read (fill in)."
    }
  ]
}
