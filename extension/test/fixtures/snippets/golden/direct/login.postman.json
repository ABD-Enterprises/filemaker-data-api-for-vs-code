{
  "info": {
    "name": "Log in (create a session)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Log in (create a session)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/fmi/data/vLatest/databases/Sales%20DB/sessions",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "description": "Fill in the account name and password yourself (never copied). The response holds the session token.",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://fm.example.com",
      "description": "The server address of the connection profile."
    },
    {
      "key": "username",
      "value": "",
      "description": "FileMaker account name (fill in; never copied)."
    },
    {
      "key": "password",
      "value": "",
      "description": "FileMaker account password (fill in; never copied)."
    }
  ]
}
