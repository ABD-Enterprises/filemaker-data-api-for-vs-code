@host = https://fm.example.com

### Find records in layout "Contacts"
POST {{host}}/fmi/data/vLatest/databases/Sales%20DB/layouts/Contacts/_find
Content-Type: application/json
Authorization: Bearer <REDACTED>

{
  "query": [
    {
      "City": "Portland",
      "Status": "==Active"
    },
    {
      "City": "Seattle",
      "omit": "true"
    }
  ],
  "sort": [
    {
      "fieldName": "Name",
      "sortOrder": "ascend"
    }
  ],
  "limit": 25,
  "offset": 26
}
