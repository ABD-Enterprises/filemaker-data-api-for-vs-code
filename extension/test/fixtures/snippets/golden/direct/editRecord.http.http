# Replace the modId with the one from the record you read: FileMaker refuses the edit (error 306) if the record changed since.
@host = https://fm.example.com
@modId = <modId>

### Edit record 42 in layout "Contacts"
PATCH {{host}}/fmi/data/vLatest/databases/Sales%20DB/layouts/Contacts/records/42
Content-Type: application/json
Authorization: Bearer <REDACTED>

{
  "fieldData": {
    "Status": "Inactive"
  },
  "modId": "{{modId}}"
}
