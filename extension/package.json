  "repository": {
    "type": "git",
    "url": "https://github.com/ABD-Enterprises/filemaker-data-api-for-vs-code.git"
  },
  "homepage": "https://abdenterprises.com?ref=vscode",
  "bugs": {
    "url": "https://github.com/ABD-Enterprises/filemaker-data-api-for-vs-code/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "filemaker",
    "database",
    "data api",
    "claris",
    "claris filemaker",
    "fmrest",
    "fm api",
    "fm rest api",
    "filemaker server",
    "filemaker cloud",
    "fmcloud",
    "fms",
    "query builder",
    "schema",
    "schema diff",
    "typescript types",
    "batch export",
    "crud"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "filemaker.features.batch.enabled",
        "filemaker.features.recordEdit.enabled",
        "filemaker.features.scriptRunner.enabled",
        "filemaker.enterprise.mode",
        "filemaker.enterprise.role",
        "filemaker.batch.maxRecords",
        "filemaker.batch.concurrency",
        "filemaker.batch.dryRunDefault"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "filemakerActivityBar",
          "title": "%viewsContainers.activitybar.filemakerActivityBar.title%",
          "icon": "media/filemaker.svg"
        }
      ]
    },
    "views": {
      "filemakerActivityBar": [
        {
          "id": "filemakerExplorer",
          "name": "%views.filemakerActivityBar.filemakerExplorer.name%",
          "contextualTitle": "%views.filemakerActivityBar.filemakerExplorer.contextualTitle%",
          "icon": "media/filemaker.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "filemakerExplorer",
        "contents": "%viewsWelcome.filemakerExplorer.contents%"
      }
    ],
    "walkthroughs": [
      {
        "id": "filemakerGettingStarted",
        "title": "%walkthroughs.filemakerGettingStarted.title%",
        "description": "%walkthroughs.filemakerGettingStarted.description%",
        "steps": [
          {
            "id": "addProfile",
            "title": "%walkthroughs.filemakerGettingStarted.steps.addProfile.title%",
            "description": "%walkthroughs.filemakerGettingStarted.steps.addProfile.description%",
            "media": {
              "markdown": "docs/walkthroughs/add-profile.md"
            },
            "completionEvents": [
              "onCommand:filemakerDataApiTools.addConnectionProfile"
            ]
          },
          {
            "id": "connect",
            "title": "%walkthroughs.filemakerGettingStarted.steps.connect.title%",
            "description": "%walkthroughs.filemakerGettingStarted.steps.connect.description%",
            "media": {
              "markdown": "docs/walkthroughs/test-connect.md"
            },
            "completionEvents": [
              "onCommand:filemakerDataApiTools.connect"
            ]
          },
          {
            "id": "runQuery",
            "title": "%walkthroughs.filemakerGettingStarted.steps.runQuery.title%",
            "description": "%walkthroughs.filemakerGettingStarted.steps.runQuery.description%",
            "media": {
              "markdown": "docs/walkthroughs/query-builder.md"
            },
            "completionEvents": [
              "onCommand:filemakerDataApiTools.openQueryBuilder"
            ]
          }
        ]
      }
    ],
